    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "clean-css": "^5.3.3",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "gulp-nunjucks": "^6.1.0",
    "gulp-sass": "^6.0.1",
    "html-minifier-terser": "^7.2.0",
    "nanoevents": "^10.0.0",
    "pako": "^3.0.2",
    "prismjs": "^1.30.0",
    "rollup": "^4.65.0",
    "sass": "^1.106.1",
    "sirv": "^3.0.2",
    "sirv-cli": "^3.0.1",
    "stylelint": "^16.26.1",
